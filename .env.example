# ===== Required =====
# Anthropic Claude key — used by the Streamlit narrative generator (only).
# Not required by the FastAPI service itself.
ANTHROPIC_API_KEY=sk-ant-...

# ===== Optional - Runtime =====
# Free-form label exposed in /health. Set to "production" on Railway.
ENVIRONMENT=development

# ===== Optional - Logging =====
LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=text                # "text" for dev, "json" for Railway

# ===== Optional - CORS =====
# Comma-separated list of allowed origins added to the localhost defaults.
# Vercel preview URLs and *.pvengine.it are already matched via regex.
CORS_ORIGINS=https://pv-engine.vercel.app,https://www.pvengine.it

# ===== Optional - Cache =====
# Where TMY responses are persisted on disk so they survive restarts.
PVGIS_CACHE_DIR=/tmp/pvgis_cache
# In-memory LRU size (each entry ~1 MB).
PVGIS_CACHE_SIZE=500

# ===== Optional - Rate Limiting =====
# Disable for load testing; leave on in production.
RATE_LIMIT_ENABLED=true
